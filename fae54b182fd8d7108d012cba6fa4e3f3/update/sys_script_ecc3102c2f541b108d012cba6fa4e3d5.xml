        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

	var stock = parseInt(current.getValue('stock_qty'), 10);
    var reorderLevel = parseInt(current.getValue('reorder_level'), 10);

    if (stock <= reorderLevel) {
        // parm1 = current stock, parm2 = reorder level (available in the notification as event.parm1/2)
        gs.eventQueue('x_2228927_equipm_0.stock.low', current, String(stock), String(reorderLevel));
        gs.info('[x_2228927_equipm_0] Low stock event queued for ' + current.getValue('name') +
            ' (stock=' + stock + ', reorder=' + reorderLevel + ')');
    }

})(current, previous);]]></script>
