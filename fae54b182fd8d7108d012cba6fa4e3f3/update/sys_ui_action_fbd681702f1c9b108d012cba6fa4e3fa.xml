        <script><![CDATA[function markDelivered() {
    if (!confirm('Confirm the equipment has been delivered to the requester?')) {
        return false;
    }
    gsftSubmit(null, g_form.getFormElement(), 'mark_delivered');   // must match Action name
}

// ---- Server side ----
if (typeof window === 'undefined') {
    serverMarkDelivered();
}

function serverMarkDelivered() {
    current.setValue('state', '40');                       // Delivered
    current.setValue('delivered_on', new GlideDateTime().getValue());
    current.work_notes = 'Marked as delivered by ' + gs.getUserDisplayName() + '.';
    current.update();

    gs.addInfoMessage('Request ' + current.getValue('number') + ' marked as delivered.');
    action.setRedirectURL(current);   // stay on the record
}]]></script>
